{
  "name": "ai-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Professor de idiomas estilo MSN com Ollama + lfm3-omni",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "eval": "rolldown scripts/eval.ts --file out/eval/eval.mjs --platform node --format esm && node out/eval/eval.mjs"
  },
  "dependencies": {
    "eld": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
